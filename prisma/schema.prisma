// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Question {
  id             String     @id @default(cuid())
  questionType   String     @db.VarChar(100)
  content        String     @db.Text @default("")
  options        Json?
  answer         String     @default("")
  analysis       String?    @db.Text
  score          Float      @default(5)
  correctRate    Float?     @db.Real
  subject        String     @db.VarChar(100)
  source         String     @db.VarChar(200)
  grade          String?    @db.VarChar(50)
  category       String     @db.VarChar(100) @default("")
  year           Int?
  tags           String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  groupItems     GroupItem[]
  submissions    QuestionSubmission[]

  @@index([subject])
  @@index([questionType])
  @@index([category])
  @@index([year])
}

model QuestionGroup {
  id           String      @id @default(cuid())
  title        String      @db.VarChar(255)
  content      String      @db.Text
  questionType String      @db.VarChar(100)
  /// 题组分值：由单题分值自动合计（普通题组=小计，pick-one=单题满分），保留小数
  score        Float       @default(0)
  /// 作答模式：all=全部作答（默认）；pick-one=任选一题（二选一/三选一，如语文作文、微写作）
  /// pick-one 时：各小问都按满分计（如作文 50），提交只按用户作答的那一题计分，group.score == 单题满分
  answerMode   String      @default("all") @db.VarChar(20)
  subject      String      @db.VarChar(100)
  source       String      @db.VarChar(200)
  grade        String?     @db.VarChar(50)
  category     String      @db.VarChar(100)
  tags         String[]
  imageUrl     String?     @db.VarChar(500)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  groupItems   GroupItem[]
  submissions  QuestionGroupSubmission[]

  @@index([subject])
  @@index([category])
}

model GroupItem {
  id         String        @id @default(cuid())
  groupId    String
  questionId String
  orderIndex Int

  group      QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([groupId, questionId])
  @@index([groupId])
}

model TestPaper {
  id          String      @id @default(cuid())
  title       String      @db.VarChar(255)
  description String?     @db.Text
  subject     String      @db.VarChar(100)
  source      String      @db.VarChar(200)
  grade       String?     @db.VarChar(50)
  year        Int?
  totalScore  Float?
  duration    Int?
  tags        String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  paperItems  PaperItem[]
  submissions TestPaperSubmission[]

  @@index([subject])
  @@index([year])
}

model PaperItem {
  id         String     @id @default(cuid())
  paperId    String
  itemId     String
  itemType   String     @db.VarChar(20)
  orderIndex Int

  paper      TestPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, itemId])
  @@index([paperId])
}

model QuestionSubmission {
  id              String    @id @default(cuid())
  userId          Int
  questionId      String
  groupSubmissionId String?
  content         Json?
  score           Float?    @db.Real
  isCorrect       Boolean?
  aiFeedback      Json?
  gradingStatus   String    @default("pending")
  /// 是否允许本次作答作为「优秀解答」展示给其他同学（提交时默认允许，回顾页可改）
  shareAsExcellent Boolean  @default(true)
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id])
  question        Question  @relation(fields: [questionId], references: [id])
  groupSubmission QuestionGroupSubmission? @relation(fields: [groupSubmissionId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
  @@index([groupSubmissionId])
  @@index([gradingStatus])
  /// 广学榜：按时间范围统计（周榜/月榜）
  @@index([createdAt])
  @@index([createdAt, userId])
}

model QuestionGroupSubmission {
  id              String    @id @default(cuid())
  userId          Int
  questionGroupId String
  testSubmissionId String?
  score           Float?    @db.Real
  isCorrect       Boolean?
  correctNum      Int?
  totalNum        Int?
  duration        Int?
  createdAt       DateTime  @default(now())

  user            User         @relation(fields: [userId], references: [id])
  questionGroup   QuestionGroup @relation(fields: [questionGroupId], references: [id])
  submissions     QuestionSubmission[]
  testSubmission  TestPaperSubmission? @relation(fields: [testSubmissionId], references: [id])

  @@index([userId])
  @@index([questionGroupId])
  @@index([userId, questionGroupId])
  @@index([testSubmissionId])
}

model TestPaperSubmission {
  id              String    @id @default(cuid())
  userId          Int
  testPaperId     String
  content         Json?
  score           Float?    @db.Real
  duration        Int?
  startedAt       DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())

  user            User         @relation(fields: [userId], references: [id])
  testPaper       TestPaper    @relation(fields: [testPaperId], references: [id])
  groupSubmissions     QuestionGroupSubmission[]

  @@index([userId])
  @@index([testPaperId])
  @@index([userId, testPaperId])
}

model User {
  id       Int       @id
  /// 广学账号用户名，登录时同步；用于「优秀解答」显示作者
  userName String?   @db.VarChar(100)

  questionSubmissions      QuestionSubmission[]
  groupSubmissions         QuestionGroupSubmission[]
  testPaperSubmissions     TestPaperSubmission[]

  @@unique([id])
  @@index([id])
}

/// 题库编辑审计日志：谁（管理员）在什么时候改了哪个题组 / 小题的哪些字段。
/// 独立表、不建外键：管理员来自 SSO（本地 User 表可能没有记录），题目也可能被删除。
model AdminEditLog {
  id          String   @id @default(cuid())
  /// 操作管理员（SSO userId）
  adminId     Int
  adminName   String?  @db.VarChar(100)
  /// update-group | update-question | upload-cover | delete-cover
  action      String   @db.VarChar(30)
  /// group | question
  targetType  String   @db.VarChar(20)
  targetId    String   @db.VarChar(64)
  /// 变更对象的人类可读标识（题组标题 / 小题题干摘要）
  targetLabel String   @db.VarChar(255)
  groupId     String?  @db.VarChar(64)
  groupTitle  String?  @db.VarChar(255)
  /// 字段级 diff：{ field: { before, after, beforeLength?, afterLength? } }
  changes     Json?
  /// 补充说明（如「选用候选封面 #3 · 相关度 0.512 · 出处链接」）
  summary     String?  @db.VarChar(500)
  /// 请求来源 IP（nginx 透传的真实客户端 IP）
  ip          String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([groupId])
  @@index([adminId])
  @@index([createdAt])
}