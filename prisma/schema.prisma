// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Question {
  id             String     @id @default(cuid())
  questionType   String     @db.VarChar(100)
  content        String     @db.Text @default("")
  options        Json?
  answer         String     @default("")
  analysis       String?    @db.Text
  score          Int        @default(5)
  correctRate    Float?     @db.Real
  subject        String     @db.VarChar(100)
  source         String     @db.VarChar(200)
  grade          String?    @db.VarChar(50)
  category       String     @db.VarChar(100) @default("")
  year           Int?
  tags           String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  groupItems     GroupItem[]
  submissions    QuestionSubmission[]

  @@index([subject])
  @@index([questionType])
  @@index([category])
  @@index([year])
}

model QuestionGroup {
  id           String      @id @default(cuid())
  title        String      @db.VarChar(255)
  content      String      @db.Text
  questionType String      @db.VarChar(100)
  score        Int         @default(0)
  subject      String      @db.VarChar(100)
  source       String      @db.VarChar(200)
  grade        String?     @db.VarChar(50)
  category     String      @db.VarChar(100)
  tags         String[]
  imageUrl     String?     @db.VarChar(500)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  groupItems   GroupItem[]
  submissions  QuestionGroupSubmission[]

  @@index([subject])
  @@index([category])
}

model GroupItem {
  id         String        @id @default(cuid())
  groupId    String
  questionId String
  orderIndex Int

  group      QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([groupId, questionId])
  @@index([groupId])
}

model TestPaper {
  id          String      @id @default(cuid())
  title       String      @db.VarChar(255)
  description String?     @db.Text
  subject     String      @db.VarChar(100)
  source      String      @db.VarChar(200)
  grade       String?     @db.VarChar(50)
  year        Int?
  totalScore  Int?
  duration    Int?
  tags        String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  paperItems  PaperItem[]
  submissions TestPaperSubmission[]

  @@index([subject])
  @@index([year])
}

model PaperItem {
  id         String     @id @default(cuid())
  paperId    String
  itemId     String
  itemType   String     @db.VarChar(20)
  orderIndex Int

  paper      TestPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, itemId])
  @@index([paperId])
}

model QuestionSubmission {
  id              String    @id @default(cuid())
  userId          Int
  questionId      String
  groupSubmissionId String?
  content         Json?
  score           Float?    @db.Real
  isCorrect       Boolean?
  aiFeedback      Json?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id])
  question        Question  @relation(fields: [questionId], references: [id])
  groupSubmission QuestionGroupSubmission? @relation(fields: [groupSubmissionId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
  @@index([groupSubmissionId])
}

model QuestionGroupSubmission {
  id              String    @id @default(cuid())
  userId          Int
  questionGroupId String
  testSubmissionId String?
  score           Float?    @db.Real
  isCorrect       Boolean?
  correctNum      Int?
  totalNum        Int?
  duration        Int?
  createdAt       DateTime  @default(now())

  user            User         @relation(fields: [userId], references: [id])
  questionGroup   QuestionGroup @relation(fields: [questionGroupId], references: [id])
  submissions     QuestionSubmission[]
  testSubmission  TestPaperSubmission? @relation(fields: [testSubmissionId], references: [id])

  @@index([userId])
  @@index([questionGroupId])
  @@index([userId, questionGroupId])
  @@index([testSubmissionId])
}

model TestPaperSubmission {
  id              String    @id @default(cuid())
  userId          Int
  testPaperId     String
  content         Json?
  score           Float?    @db.Real
  duration        Int?
  startedAt       DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())

  user            User         @relation(fields: [userId], references: [id])
  testPaper       TestPaper    @relation(fields: [testPaperId], references: [id])
  groupSubmissions     QuestionGroupSubmission[]

  @@index([userId])
  @@index([testPaperId])
  @@index([userId, testPaperId])
}

model User {
  id       Int       @id

  questionSubmissions      QuestionSubmission[]
  groupSubmissions         QuestionGroupSubmission[]
  testPaperSubmissions     TestPaperSubmission[]

  @@unique([id])
  @@index([id])
}